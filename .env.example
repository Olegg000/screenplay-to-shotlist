# Copy to .env and fill in your own key, or export the variable in your shell.
# The application reads spring.ai.openai.api-key from OPENAI_API_KEY.
#
# Note: Spring Boot does not auto-load .env files. Either export the variable
#   export OPENAI_API_KEY=sk-your-key-here
# or set it in your IDE run configuration before starting the app.
OPENAI_API_KEY=sk-your-openai-api-key-here
